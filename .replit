modules = ["nodejs-20", "web"]
run = "node server.js"

[nix]
channel = "stable-25_05"
packages = ["unzip"]

[deployment]
run = ["sh", "-c", "node index.js"]

[workflows]
runButton = "Project"

[[workflows.workflow]]
name = "Project"
mode = "parallel"
author = "agent"

[[workflows.workflow.tasks]]
task = "workflow.run"
args = "TV App Server"

[[workflows.workflow]]
name = "TV App Server"
author = "agent"

[[workflows.workflow.tasks]]
task = "shell.exec"
args = "node server.js"
waitForPort = 5000

[workflows.workflow.metadata]
outputType = "webview"

[[ports]]
localPort = 5000
externalPort = 80

[agent]
expertMode = true
